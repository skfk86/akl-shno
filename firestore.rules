rules_version = '2';

// أكل شنو؟ — قواعد Firestore
// تعمل على الخطة المجانية Spark بدون Cloud Functions.
// كل منطق الإنذارات والحظر والاشتراكات مفروض هنا، فلا يمكن تجاوزه بتعديل التطبيق.

service cloud.firestore {
  match /databases/{db}/documents {

    // ───────── دوال مساعدة ─────────
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(uid()));
    }
    function userDoc(id) { return get(/databases/$(db)/documents/users/$(id)).data; }
    function restDoc(id) { return get(/databases/$(db)/documents/restaurants/$(id)).data; }
    function activeRest(id) {
      let r = restDoc(id);
      return r.subActiveUntil != null && r.subActiveUntil > request.time && r.get('listed', false) == true;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ───────── الأدمن ─────────
    // أنشئ مستنداً باسم uid حسابك يدوياً من Firebase Console: admins/{uid}
    match /admins/{id} {
      allow read: if signedIn() && uid() == id;
      allow write: if false;
    }

    // ───────── المستخدمون ─────────
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());

      allow create: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['role', 'name', 'phone', 'addresses', 'strikes', 'delivered', 'createdAt'])
        && request.resource.data.role in ['customer', 'owner']
        && request.resource.data.strikes == 0
        && request.resource.data.delivered == 0;

      allow update: if isAdmin()
        || (signedIn() && uid() == userId && changedOnly(['name', 'phone', 'addresses', 'fcmToken', 'deviceId']))
        || strikeFromReport(userId)
        || deliveredFromOrder(userId);

      // حذف الحساب من داخل التطبيق (متطلب Google Play)
      allow delete: if signedIn() && (uid() == userId || isAdmin());
    }

    // إنذار: +1 فقط، وفي نفس الـ batch الذي ينشئ بلاغاً جديداً عن هذا الزبون.
    function strikeFromReport(userId) {
      let rid = request.resource.data.lastReportId;
      let rep = getAfter(/databases/$(db)/documents/reports/$(rid)).data;
      return signedIn()
        && changedOnly(['strikes', 'lastReportId'])
        && request.resource.data.strikes == resource.data.strikes + 1
        && !exists(/databases/$(db)/documents/reports/$(rid))
        && rep.restaurantId == uid()
        && rep.customerId == userId;
    }

    // طلب مستلَم: +1 مع تحويل الطلب إلى delivered في نفس الـ batch.
    function deliveredFromOrder(userId) {
      let oid = request.resource.data.lastDeliveredOrder;
      let before = get(/databases/$(db)/documents/orders/$(oid)).data;
      let after = getAfter(/databases/$(db)/documents/orders/$(oid)).data;
      return signedIn()
        && changedOnly(['delivered', 'lastDeliveredOrder'])
        && request.resource.data.delivered == resource.data.delivered + 1
        && before.status in ['out_for_delivery', 'ready']
        && after.status == 'delivered'
        && after.restaurantId == uid()
        && after.customerId == userId;
    }

    // ───────── المطاعم ─────────
    // معرّف المطعم = uid صاحبه.
    // listed يضبطه الأدمن فقط عند التفعيل؛ القائمة تُستعلم بـ where('listed', '==', true)
    // والتطبيق يخفي المنتهي اشتراكه. استقبال الطلبات نفسه مشروط بالاشتراك الساري (activeRest).
    match /restaurants/{rid} {
      allow get: if (resource.data.subActiveUntil != null && resource.data.subActiveUntil > request.time)
        || (signedIn() && (uid() == rid || isAdmin()));
      allow list: if signedIn() && (resource.data.listed == true || isAdmin());

      allow create: if signedIn() && uid() == rid
        && userDoc(uid()).role == 'owner'
        && request.resource.data.ownerId == uid()
        && request.resource.data.subActiveUntil == null
        && request.resource.data.freeTrial == false
        && request.resource.data.listed == false
        && request.resource.data.get('approved', false) == false;

      allow update: if isAdmin()
        || (signedIn() && uid() == rid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'subActiveUntil', 'freeTrial', 'listed', 'verified', 'ratingSum', 'ratingCount', 'lastRatingId', 'approved', 'rejectReason', 'reviewedAt', 'autoReview', 'autoApproved', 'proofHash', 'featuredUntil', 'featuredNotified', 'popular'])
            // المطعم يستطيع فقط إرسال طلب المراجعة، والقرار للإدارة
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['review']) || request.resource.data.review == 'pending'))
        || ratingFromCustomer(rid);

      allow delete: if signedIn() && (uid() == rid || isAdmin());

      // المنيو والعروض ومناطق التوصيل
      match /{sub}/{docId} {
        allow read: if true;
        // لا يضيف المطعم منيو أو عروضاً قبل قبوله من الإدارة
        allow write: if signedIn() && uid() == rid && sub in ['menu', 'offers', 'zones'] && accepted(rid);
      }
    }

    // المطعم المقبول: وافقت عليه الإدارة، أو فُعّل اشتراكه (المطاعم القديمة قبل نظام التوثيق)
    function accepted(rid) {
      let r = get(/databases/$(db)/documents/restaurants/$(rid)).data;
      return r.get('approved', false) == true || r.get('subActiveUntil', null) != null;
    }

    // تقييم: الزبون يضيف تقييمه للمجموع في نفس الـ batch الذي ينشئ فيه مستند التقييم
    function ratingFromCustomer(rid) {
      let id = request.resource.data.lastRatingId;
      let rt = getAfter(/databases/$(db)/documents/ratings/$(id)).data;
      let o = get(/databases/$(db)/documents/orders/$(id)).data;
      return signedIn()
        && changedOnly(['ratingSum', 'ratingCount', 'lastRatingId'])
        && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
        && request.resource.data.ratingSum == resource.data.get('ratingSum', 0) + rt.stars
        && !exists(/databases/$(db)/documents/ratings/$(id))
        && rt.customerId == uid()
        && o.customerId == uid()
        && o.restaurantId == rid
        && o.status == 'delivered';
    }

    // ───────── الصور ─────────
    // صورة مضغوطة كـ data URL، أقل من 200KB، ويحذفها صاحبها فقط.
    match /images/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'data', 'createdAt'])
        && request.resource.data.owner == uid()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000
        && request.resource.data.data.matches('data:image/(webp|jpeg);base64,.*')
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.owner == uid() || isAdmin());
    }

    // ───────── التقييمات ─────────
    // معرّف التقييم = معرّف الطلب: تقييم واحد لكل طلب مستلَم، ولا يُعدَّل بعد ذلك.
    match /ratings/{oid} {
      allow read: if true;
      allow create: if signedIn() && validRating(oid);
    }

    function validRating(oid) {
      let d = request.resource.data;
      let o = get(/databases/$(db)/documents/orders/$(oid)).data;
      return d.customerId == uid()
        && o.customerId == uid()
        && o.status == 'delivered'
        && d.restaurantId == o.restaurantId
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.comment is string && d.comment.size() <= 300
        && d.createdAt == request.time
        && getAfter(/databases/$(db)/documents/restaurants/$(o.restaurantId)).data.lastRatingId == oid;
    }

    // ───────── الأجهزة المحظورة ─────────
    // تُضاف تلقائياً من مرسل الإشعارات عند وصول الإنذارات إلى 3، ويرفعها الأدمن.
    // إعدادات الإدارة (مثل تشغيل المراجعة التلقائية) وطابور حذف الحسابات: للأدمن فقط
    match /settings/{id} {
      allow read, write: if isAdmin();
    }
    // بصمات صور الإثبات (لكشف الصور المكررة): للأدمن فقط
    match /proofHashes/{h} {
      allow read, write: if isAdmin();
    }
    match /deleteQueue/{uid} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && !exists(/databases/$(db)/documents/admins/$(uid))
        && request.resource.data.keys().hasOnly(['at', 'ban', 'reason', 'name'])
        && request.resource.data.at == request.time;
    }

    match /bannedDevices/{id} {
      allow get: if signedIn();
      allow list, delete: if isAdmin();
      allow create, update: if false;
    }

    // ───────── الطلبات ─────────
    match /orders/{oid} {
      allow read: if signedIn()
        && (resource.data.customerId == uid() || resource.data.restaurantId == uid() || isAdmin());

      allow create: if signedIn() && validNewOrder();

      allow update: if isAdmin()
        || (signedIn() && resource.data.customerId == uid()
            && resource.data.status == 'new'
            && request.resource.data.status == 'cancelled'
            && changedOnly(['status']))
        || (signedIn() && resource.data.restaurantId == uid() && validTransition(oid));
    }

    function validNewOrder() {
      let d = request.resource.data;
      let u = userDoc(uid());
      return d.customerId == uid()
        && u.role == 'customer'
        && u.strikes < 3                                   // 3 إنذارات = حظر
        && u.get('deviceId', '') != ''                     // يجب تسجيل معرّف الجهاز
        && !exists(/databases/$(db)/documents/bannedDevices/$(u.get('deviceId', 'none')))  // جهاز محظور
        && (u.strikes < 2 || d.payMethod == 'bankak')      // إنذاران = دفع مسبق إلزامي
        && (u.delivered >= 2 || d.payMethod == 'bankak' || d.total <= 50000) // حد للكاش في أول طلبين
        && d.customerStrikes == u.strikes
        && d.customerDelivered == u.delivered
        && activeRest(d.restaurantId)
        && d.status == 'new'
        && d.reported == false
        && d.type in ['delivery', 'pickup']
        && d.payMethod in ['cash', 'bankak']
        && d.total is number && d.total > 0
        && d.createdAt == request.time;
    }

    function validTransition(oid) {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return
        (changedOnly(['status']) && (
            (from == 'new' && to in ['accepted', 'rejected'])
         || (from == 'accepted' && to == 'preparing')
         || (from == 'preparing' && to == 'ready')
         || (from in ['out_for_delivery', 'ready'] && to == 'delivered')))
        || (from in ['preparing', 'ready'] && to == 'out_for_delivery'
            && resource.data.type == 'delivery'
            && changedOnly(['status', 'outAt'])
            && request.resource.data.outAt == request.time)
        || (from == 'out_for_delivery'
            && changedOnly(['reported'])
            && resource.data.reported == false
            && request.resource.data.reported == true
            && existsAfter(/databases/$(db)/documents/reports/$(oid)));
    }

    // ───────── دردشة الطلب ─────────
    // بين الزبون والمطعم صاحبي الطلب فقط. الرسالة لا تُعدَّل ولا تُحذف.
    match /orders/{oid}/messages/{mid} {
      function ord() { return get(/databases/$(db)/documents/orders/$(oid)).data; }
      allow read: if signedIn() && (ord().customerId == uid() || ord().restaurantId == uid() || isAdmin());
      allow create: if signedIn() && validMsg()
        && ((ord().customerId == uid() && request.resource.data.role == 'customer')
         || (ord().restaurantId == uid() && request.resource.data.role == 'restaurant'))
        && !(ord().status in ['cancelled', 'rejected']);
    }
    function validMsg() {
      let d = request.resource.data;
      return d.keys().hasOnly(['from', 'role', 'text', 'at', 'notified'])
        && d.from == uid() && d.text is string && d.text.size() > 0 && d.text.size() <= 500
        && d.at == request.time && d.notified == false;
    }

    // ───────── الدردشة المباشرة (زبون ↔ مطعم) ─────────
    // معرّف المحادثة = restaurantId_customerId، فلكل زبون محادثة واحدة مع كل مطعم.
    match /chats/{cid} {
      function isParty(d) { return signedIn() && (d.customerId == uid() || d.restaurantId == uid()); }
      function chatKeys() { return ['customerId', 'restaurantId', 'customerName', 'restaurantName', 'lastAt', 'lastText', 'lastFrom']; }
      allow read: if isParty(resource.data) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(chatKeys())
        && request.resource.data.customerId == uid()
        && cid == request.resource.data.restaurantId + '_' + uid()
        && exists(/databases/$(db)/documents/restaurants/$(request.resource.data.restaurantId))
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastFrom == 'customer';
      allow update: if isParty(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastText', 'lastFrom', 'customerName', 'restaurantName'])
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastFrom == (uid() == resource.data.customerId ? 'customer' : 'restaurant');
      match /messages/{mid} {
        function chatDoc() { return getAfter(/databases/$(db)/documents/chats/$(cid)).data; }
        allow read: if isParty(get(/databases/$(db)/documents/chats/$(cid)).data) || isAdmin();
        allow create: if signedIn() && validMsg()
          && ((chatDoc().customerId == uid() && request.resource.data.role == 'customer')
           || (chatDoc().restaurantId == uid() && request.resource.data.role == 'restaurant'));
      }
    }

    // ───────── الدعم (المستخدم ↔ الإدارة) ─────────
    match /support/{u} {
      allow read: if signedIn() && (uid() == u || isAdmin());
      allow create, update: if signedIn() && (uid() == u || isAdmin())
        && request.resource.data.keys().hasOnly(['name', 'lastAt', 'lastText', 'lastFrom'])
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastFrom in ['user', 'admin'];
      match /messages/{mid} {
        allow read: if signedIn() && (uid() == u || isAdmin());
        allow create: if signedIn() && validMsg()
          && ((uid() == u && request.resource.data.role == 'user')
           || (isAdmin() && request.resource.data.role == 'admin'));
      }
    }

    // ───────── البلاغات ─────────
    match /reports/{oid} {
      allow read: if signedIn()
        && (resource.data.customerId == uid() || resource.data.restaurantId == uid() || isAdmin());

      allow create: if signedIn() && validNewReport(oid);

      allow update: if isAdmin()
        || (signedIn() && resource.data.customerId == uid()
            && resource.data.status == 'open'
            && request.resource.data.status == 'disputed'
            && changedOnly(['status', 'dispute'])
            && request.resource.data.dispute is string
            && request.resource.data.dispute.size() <= 300);
    }

    function validNewReport(oid) {
      let d = request.resource.data;
      let o = get(/databases/$(db)/documents/orders/$(oid)).data;
      let cust = d.customerId;
      return o.restaurantId == uid()
        && o.status == 'out_for_delivery'
        && o.reported == false
        && d.restaurantId == uid()
        && cust == o.customerId
        && d.reason in ['no_answer', 'refused', 'fake_address']
        && d.status == 'open'
        && d.createdAt == request.time
        && getAfter(/databases/$(db)/documents/orders/$(oid)).data.reported == true
        && getAfter(/databases/$(db)/documents/users/$(cust)).data.strikes
             == get(/databases/$(db)/documents/users/$(cust)).data.strikes + 1;
    }

    // ───────── مدفوعات الاشتراك (بنكك) ─────────
    match /payments/{pid} {
      allow read: if signedIn() && (resource.data.restaurantId == uid() || isAdmin());
      allow create: if signedIn()
        && request.resource.data.restaurantId == uid()
        && accepted(uid())
        && request.resource.data.status == 'pending'
        && request.resource.data.get('kind', 'sub') in ['sub', 'featured']
        && (request.resource.data.get('kind', 'sub') == 'sub' || request.resource.data.get('days', 0) in [7, 30])
        && request.resource.data.txnId is string
        && request.resource.data.txnId.size() <= 40
        && request.resource.data.amount is number
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
    }
  }
}
